# OS / Editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Python cache/build
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/
aura_env/
aura_backend/.venv/

# Node
**/node_modules/
**/dist/
**/.vite/

# Environment files
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Logs / temp
*.log
logs/
*.tmp
*.temp

# Runtime artifacts (backend)
aura_backend/received_models/
aura_backend/xai_reports/
